# Скопируйте в .env и подставьте токен от @BotFather
BOT_TOKEN=0000000000:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# SQLite (встроенный node:sqlite): путь к файлу БД. Нужен Node.js 22.5+.
DATABASE_PATH=data/bot.db

# Опционально: chat_id репетитора — дублировать уведомления о записях в личку (иначе только console.log)
# TUTOR_CHAT_ID=

# Опционально: свободные вопросы через OpenAI (без ключа — эвристика по FAQ)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
