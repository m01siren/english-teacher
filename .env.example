# Скопируйте в .env и подставьте токен от @BotFather
BOT_TOKEN=0000000000:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# SQLite (встроенный node:sqlite): путь к файлу БД. Нужен Node.js 22.5+.
DATABASE_PATH=data/bot.db

# Опционально: chat_id администратора / координатора — дублировать уведомления о заявках (иначе только console.log)
# TUTOR_CHAT_ID=

# OpenAI: ответы ассистента по свободному тексту (без ключа — простой fallback по FAQ)
# Получить ключ: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Модель (по умолчанию в коде: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# --- RAG / Knowledge Base indexing ---
# URL проекта Supabase (Settings -> API -> Project URL)
SUPABASE_URL=

# Service role key (Settings -> API -> service_role, держать в секрете)
SUPABASE_SERVICE_ROLE_KEY=

# Источник для ручной индексации (по умолчанию: ./регламент.txt)
# KB_SOURCE_PATH=C:/Users/irano/OneDrive/Рабочий стол/учеба/бот для репетитора/регламент.txt

# Идентификатор источника (метка документа в векторной базе)
# KB_SOURCE_ID=reglament

# Модель эмбеддингов для индексации
# OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small

# Размеры фрагментов (можно оставить по умолчанию)
# KB_CHUNK_SIZE=900
# KB_CHUNK_OVERLAP=120
